---
source: crates/yard-core/src/render/mod.rs
expression: "nginx::nginx_main(&ctx(&p, &b))"
---
# Generated by Yard — edit /Users/me/Library/Application Support/Yard/nginx/overrides instead
daemon off;
worker_processes auto;
pid "/Users/me/Library/Application Support/Yard/run/nginx.pid";
error_log "/Users/me/Library/Application Support/Yard/logs/nginx-error.log";

events {
    worker_connections 1024;
}

http {
    include "/opt/homebrew/etc/nginx/mime.types";
    default_type application/octet-stream;
    access_log off;
    sendfile on;
    client_max_body_size 1G;
    server_names_hash_bucket_size 128;
    client_body_temp_path "/Users/me/Library/Application Support/Yard/run/nginx/client_body";
    proxy_temp_path "/Users/me/Library/Application Support/Yard/run/nginx/proxy";
    fastcgi_temp_path "/Users/me/Library/Application Support/Yard/run/nginx/fastcgi";
    uwsgi_temp_path "/Users/me/Library/Application Support/Yard/run/nginx/uwsgi";
    scgi_temp_path "/Users/me/Library/Application Support/Yard/run/nginx/scgi";

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Unknown hosts get the list of sites Yard serves.
    server {
        listen 127.0.0.1:8080 default_server;
        listen [::1]:8080 default_server;
        server_name _;
        root "/Users/me/Library/Application Support/Yard/nginx/default";
        index index.html;

        location / {
            try_files /index.html =404;
        }
    }

    # Unknown hosts on the https port are refused, not handed to the first secured site.
    server {
        listen 127.0.0.1:8443 ssl default_server;
        listen [::1]:8443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }

    include "/Users/me/Library/Application Support/Yard/nginx/sites/*.conf";
    include "/Users/me/Library/Application Support/Yard/nginx/services/*.conf";
}
