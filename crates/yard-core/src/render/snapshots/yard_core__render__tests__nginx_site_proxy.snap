# Generated by Yard — edit /Users/me/Library/Application Support/Yard/nginx/overrides/api.conf instead
server {
    listen 127.0.0.1:8080;
    listen [::1]:8080;
    server_name api.yard *.api.yard;
    client_max_body_size 1G;

    location / {
        proxy_pass "http://127.0.0.1:3000";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 3600;
    }

    include "/Users/me/Library/Application Support/Yard/nginx/overrides/api.conf";
}
