---
source: crates/yard-core/src/render/mod.rs
expression: "php::fpm_conf(&ctx(&p, &b), v(\"8.4\"))"
---
; Generated by Yard — edit /Users/me/Library/Application Support/Yard/php/8.4/conf.d/99-overrides.ini instead
[global]
pid = "/Users/me/Library/Application Support/Yard/run/php-8.4.pid"
error_log = /dev/stderr
daemonize = no

[yard]
listen = "/Users/me/Library/Application Support/Yard/run/php-8.4.sock"
listen.mode = 0600
pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 30s
catch_workers_output = yes
decorate_workers_output = no
; libpq looks for Kerberos credentials on every connect unless told not to, which can
; crash a worker inside CoreFoundation: a forked php-fpm child is not safe to use it.
env[PGGSSENCMODE] = disable
