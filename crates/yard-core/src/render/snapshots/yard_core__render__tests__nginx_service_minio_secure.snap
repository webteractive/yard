# Generated by Yard — edit /Users/me/Library/Application Support/Yard/services/minio/overrides.conf instead
server {
    listen 127.0.0.1:8080;
    listen [::1]:8080;
    server_name minio.yard;
    return 301 https://$host:8443$request_uri;
}

server {
    listen 127.0.0.1:8443 ssl;
    listen [::1]:8443 ssl;
    server_name minio.yard;
    client_max_body_size 1G;
    ssl_certificate "/Users/me/Library/Application Support/Yard/certs/services/minio.pem";
    ssl_certificate_key "/Users/me/Library/Application Support/Yard/certs/services/minio.key";
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass "http://127.0.0.1:9001";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host 127.0.0.1:9001;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 3600;
    }

    include "/Users/me/Library/Application Support/Yard/services/minio/overrides.conf";
}
