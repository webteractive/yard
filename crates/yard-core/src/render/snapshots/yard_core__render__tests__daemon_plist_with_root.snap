<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.more.yard.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/yardd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/yardd.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/yardd.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>YARD_ROOT</key>
		<string>/Users/me/Library/Application Support/Yard</string>
	</dict>
</dict>
</plist>
