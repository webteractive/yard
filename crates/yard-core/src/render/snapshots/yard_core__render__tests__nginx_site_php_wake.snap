---
source: crates/yard-core/src/render/mod.rs
expression: "nginx::nginx_site(&ctx(&p, &b), &php_site(\"blog\", \"/Users/me/Herd/blog\"),\ntrue)"
---
# Generated by Yard — edit /Users/me/Library/Application Support/Yard/nginx/overrides/blog.conf instead
server {
    listen 127.0.0.1:8080;
    listen [::1]:8080;
    server_name blog.yard *.blog.yard;
    client_max_body_size 1G;

    root "/Users/me/Herd/blog/public";
    index index.php index.html;
    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        auth_request /__yard_wake;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass "unix:/Users/me/Library/Application Support/Yard/run/php-8.4.sock";
        fastcgi_index index.php;
        include "/opt/homebrew/etc/nginx/fastcgi_params";
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_read_timeout 3600;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location = /__yard_wake {
        internal;
        proxy_pass "http://unix:/Users/me/Library/Application Support/Yard/run/wake.sock:/wake/blog?wait=10";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_read_timeout 15s;
        proxy_intercept_errors on;
        error_page 400 401 403 404 500 502 503 504 = @yard_wake_skipped;
    }

    location @yard_wake_skipped {
        return 204;
    }

    include "/Users/me/Library/Application Support/Yard/nginx/overrides/blog.conf";
}
